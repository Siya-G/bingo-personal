APP_NAME="AI Bingo API"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./bingo.db"
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Bingo join links in invite emails (browser origin, no trailing slash).
FRONTEND_BASE_URL=http://127.0.0.1:3000

# Optional SMTP — leave empty for demo preview-only invites.
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true  (use a Google App Password)
# Outlook: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USE_TLS=true
# Implicit SSL on port 465: SMTP_USE_SSL=true  SMTP_USE_TLS=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_TIMEOUT_SECONDS=20

# OpenAI (server only — never put keys in the Next.js bundle).
# Settings load from backend/.env next to this folder (not cwd). Copy this file to .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
USE_MOCK_LLM=false

# Bingo: shared LLM/mock pool target (default 75), minimum acceptable unique items (default 40),
# and 5×5 card cell count (25). Generation succeeds at or above the minimum if the model is short.
BINGO_ITEM_POOL_SIZE=75
BINGO_MIN_ITEM_POOL_SIZE=40
BINGO_CARD_CELL_COUNT=25

# Chat moderation. The local rule-based filter is always on (slurs, harassment,
# threats, HTML/script injection, spam patterns). Set CHAT_USE_AI_MODERATION to
# layer the OpenAI Moderation API on top — only used when OPENAI_API_KEY is set.
# Override the default word list by pointing CHAT_BLOCKED_WORDS_FILE at a JSON
# file with shape {"blocked_terms": ["..."]}.
CHAT_USE_AI_MODERATION=false
# CHAT_BLOCKED_WORDS_FILE=/absolute/path/to/blocked-words.json

# Opt-in host voice (Bingo Agent narration). VOICE_PROVIDER selects which
# backend is used when a host enables HOST_VOICE on their game; demo means no
# external API call. VOICE_PROFILE_TTL_HOURS controls how long a cloned/host
# voice profile is kept before it should be expired and its sample audio
# cleaned up. The provider keys are only read when the matching provider is
# selected — leave them empty for the default demo path.
# Host voice narration: demo = browser only; elevenlabs = instant clone + TTS
VOICE_PROVIDER=demo
VOICE_PROFILE_TTL_HOURS=24
ELEVENLABS_API_KEY=your-key-here
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Admin secret for cache-management endpoints (DELETE /admin/cache/topics).
# Leave empty to disable all admin endpoints.
ADMIN_SECRET=
